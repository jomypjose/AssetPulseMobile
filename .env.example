# ──────────────────────────────────────────────────────────────────────────────
# AssetPulse Mobile — environment variables
#
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed to source control.
#
# For EAS cloud builds, create a secret instead:
#   eas secret:create --scope project --name API_BASE_URL --value "https://..."
# ──────────────────────────────────────────────────────────────────────────────

# Full HTTPS URL to the AssetPulse API (must use https://, not http://)
API_BASE_URL=https://your-domain.example.com/api
