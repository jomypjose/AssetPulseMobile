# google-services.json is tracked here because it was tracked in the monorepo
# and the Android build needs it. It is Firebase *client* config (project id,
# app id, client key) — not a server secret — but review before making this
# repo public.
# android/app/google-services.json
ios/GoogleService-Info.plist
*.keystore
*.jks
!android/app/debug.keystore

# Logs / OS
*.log
npm-debug.*
yarn-debug.*
.DS_Store

# Kotlin incremental-build cache
android/.kotlin/
